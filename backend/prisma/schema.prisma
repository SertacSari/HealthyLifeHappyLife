generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model body_measurements {
  id          Int       @id @default(autoincrement())
  user_id     Int
  weight_kg   Decimal?  @db.Decimal(5, 1)
  height_cm   Decimal?  @db.Decimal(5, 1)
  note        String?   @db.VarChar(200)
  measured_at DateTime? @default(now()) @db.Timestamptz(6)
  users       users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id, measured_at], map: "idx_body_measurements_user")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model follows {
  follower_user_id                       Int
  following_user_id                      Int
  created_at                             DateTime? @default(now()) @db.Timestamptz(6)
  users_follows_follower_user_idTousers  users     @relation("follows_follower_user_idTousers", fields: [follower_user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users_follows_following_user_idTousers users     @relation("follows_following_user_idTousers", fields: [following_user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([follower_user_id, following_user_id])
  @@index([follower_user_id], map: "idx_follows_follower")
  @@index([following_user_id], map: "idx_follows_following")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model food_catalog {
  id             Int              @id @default(autoincrement())
  name           String           @db.VarChar(200)
  category       String           @db.VarChar(50)
  calories       Int
  protein        Decimal?         @default(0) @db.Decimal(6, 1)
  carbs          Decimal?         @default(0) @db.Decimal(6, 1)
  fats           Decimal?         @default(0) @db.Decimal(6, 1)
  serving_size   String?          @default("1 porsiyon") @db.VarChar(50)
  is_custom      Boolean?         @default(false)
  created_by     Int?
  users          users?           @relation(fields: [created_by], references: [id], onUpdate: NoAction)
  user_favorites user_favorites[]

  @@index([category], map: "idx_food_catalog_category")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model meals {
  id        Int       @id @default(autoincrement())
  user_id   Int
  name      String    @db.VarChar(140)
  calories  Int
  protein   Int?      @default(0)
  carbs     Int?      @default(0)
  fats      Int?      @default(0)
  logged_at DateTime? @default(now()) @db.Timestamptz(6)
  users     users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id, logged_at], map: "idx_meals_user_date")
}

model profiles {
  user_id                Int       @id
  name                   String    @db.VarChar(120)
  goal_calories          Int?      @default(2000)
  goal_workouts_per_week Int?      @default(3)
  updated_at             DateTime? @default(now()) @db.Timestamptz(6)
  water_goal_ml          Int?      @default(2500)
  height_cm              Decimal?  @db.Decimal(5, 1)
  onboarding_completed   Boolean?  @default(false)
  birth_year             Int?
  gender                 String?   @db.VarChar(20)
  activity_level         String?   @db.VarChar(50)
  users                  users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model reminders {
  user_id       Int       @id
  enabled       Boolean?  @default(false)
  reminder_time DateTime? @default(dbgenerated("'20:00:00'::time without time zone")) @db.Time(6)
  frequency     String?   @default("daily") @db.VarChar(20)
  updated_at    DateTime? @default(now()) @db.Timestamptz(6)
  users         users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model user_favorites {
  user_id      Int
  food_id      Int
  food_catalog food_catalog @relation(fields: [food_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users        users        @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, food_id])
}

model users {
  id                                       Int                 @id @default(autoincrement())
  email                                    String              @unique @db.VarChar(255)
  password_hash                            String
  password_salt                            String
  created_at                               DateTime?           @default(now()) @db.Timestamptz(6)
  is_verified                              Boolean?            @default(false)
  verification_token                       String?             @db.VarChar(255)
  reset_token                              String?             @db.VarChar(255)
  reset_expiry                             DateTime?           @db.Timestamptz(6)
  body_measurements                        body_measurements[]
  follows_follows_follower_user_idTousers  follows[]           @relation("follows_follower_user_idTousers")
  follows_follows_following_user_idTousers follows[]           @relation("follows_following_user_idTousers")
  food_catalog                             food_catalog[]
  meals                                    meals[]
  profiles                                 profiles?
  reminders                                reminders?
  user_favorites                           user_favorites[]
  water_logs                               water_logs[]
  workouts                                 workouts[]
  user_badges                              user_badges[]

  @@index([email], map: "idx_users_email")
}

model user_badges {
  id         Int       @id @default(autoincrement())
  user_id    Int
  badge_key  String    @db.VarChar(50)
  awarded_at DateTime? @default(now()) @db.Timestamptz(6)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, badge_key])
  @@index([user_id], map: "idx_user_badges_user")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model water_logs {
  id        Int       @id @default(autoincrement())
  user_id   Int
  amount_ml Int
  logged_at DateTime? @default(now()) @db.Timestamptz(6)
  users     users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id, logged_at], map: "idx_water_logs_user_date")
}

model workout_templates {
  id                 Int     @id @default(autoincrement())
  name               String  @db.VarChar(140)
  category           String  @db.VarChar(50)
  description        String?
  exercises          Json    @default("[]")
  estimated_duration Int?    @default(45)
  estimated_calories Int?    @default(300)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model workouts {
  id               Int       @id @default(autoincrement())
  user_id          Int
  name             String    @db.VarChar(140)
  duration_minutes Int
  calories_burned  Int?      @default(0)
  logged_at        DateTime? @default(now()) @db.Timestamptz(6)
  users            users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id, logged_at], map: "idx_workouts_user_date")
}
